# Copy to .env and fill in. Nothing here is required to try the app locally:
# with no SMTP settings, ticket emails are saved to ./outbox and listed at /dev/outbox.

# ---- Server ------------------------------------------------------------------------------
PORT=3000
# NODE_ENV=production makes the secrets below mandatory and hides the /dev/outbox pages.
NODE_ENV=development

# ---- Security (required in production) ---------------------------------------------------
# Signs every ticket QR code. Anyone who knows it can forge tickets, so keep it private.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later invalidates every ticket that has already been emailed.
TICKET_SIGNING_SECRET=

# Passcode organizers type to open the scan portal.
ORGANIZER_PASSCODE=

# ---- Email delivery (any SMTP provider) --------------------------------------------------
# Leave SMTP_HOST empty to use the local ./outbox instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS). Defaults to true when SMTP_PORT=465, otherwise false.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# The "From" address. Must be a sender or domain verified with your provider.
MAIL_FROM=Campus Passes <tickets@your-verified-domain.example>

# Provider presets (see README for details):
#   Resend    SMTP_HOST=smtp.resend.com        SMTP_USER=resend    SMTP_PASS=<API key>
#   SendGrid  SMTP_HOST=smtp.sendgrid.net      SMTP_USER=apikey    SMTP_PASS=<API key>
#   Brevo     SMTP_HOST=smtp-relay.brevo.com   SMTP_USER=<SMTP login>   SMTP_PASS=<SMTP key>

# ---- College settings --------------------------------------------------------------------
# Shown on the home page and in the ticket email, e.g. "Upcoming at VIT".
ORG_NAME=VIT
# Comma-separated list. When set, ONLY these email domains can register. Check which one your
# campus uses. VIT Vellore/Chennai students: vitstudent.ac.in (staff: vit.ac.in).
# Leave empty to allow any address (handy while testing).
ALLOWED_EMAIL_DOMAINS=
# Events loaded into a brand-new database. Edit events.json to match your club's events.
EVENTS_FILE=./events.json

# ---- Optional ----------------------------------------------------------------------------
# Time zone used for the event time printed inside the email (browsers show local time).
EVENT_TIMEZONE=Asia/Kolkata
# Set to 1 when running behind one reverse proxy (Render, Railway, nginx) so rate limits see real IPs.
TRUST_PROXY=
# Where the SQLite file and dev outbox live. Point DB_PATH at a persistent disk when deploying.
DB_PATH=./data/tickets.db
OUTBOX_DIR=./outbox
